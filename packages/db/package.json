{
  "name": "@agentflow/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "lint": "eslint src scripts",
    "typecheck": "tsc -p tsconfig.json",
    "db:start": "tsx scripts/dev-server.ts",
