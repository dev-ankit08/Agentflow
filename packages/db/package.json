    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@agentflow/flow-schema": "workspace:*",
    "@agentflow/secret-store": "workspace:*",
    "drizzle-orm": "^0.45.4",
