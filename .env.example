# Copy to .env and adjust. All apps read this root file.

# Postgres. `pnpm db:start` runs an embedded server on 5433 (no Docker needed);
# infra/docker-compose.yml exposes the same port.
DATABASE_URL=postgres://agentflow:agentflow@localhost:5433/agentflow

# Redis (used from Phase 1 for queues and streaming; optional in Phase 0)
REDIS_URL=redis://localhost:6379

# Auth.js — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=change-me-auth-secret
AUTH_URL=http://localhost:3100
# Optional Google sign-in
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional SMTP for magic links. If empty, the sign-in link is printed to the builder console.
EMAIL_SERVER=
EMAIL_FROM=AgentFlow <no-reply@agentflow.local>
# Shows a one-click "Dev login" (demo@agentflow.local, created by db:seed). Never enable in production.
AUTH_DEV_LOGIN=true

# Shared secret: the builder signs short-lived JWTs that the API verifies.
API_JWT_SECRET=change-me-api-jwt-secret
API_URL=http://localhost:4000
API_PORT=4000

# 32-byte base64 key that encrypts provider keys and connector credentials at rest.
# Generate with the same node command as AUTH_SECRET.
SECRETS_MASTER_KEY=

# Development only. Allow HTTP nodes and MCP connectors to reach localhost/private addresses
# (needed for the bundled demo servers), and local stdio MCP servers.
ALLOW_PRIVATE_HTTP=true
ALLOW_STDIO_MCP=false
# Optional model prices (USD per million tokens) for cost tracking, e.g. {"gpt-5":{"input":1.25,"output":10}}
LLM_PRICES_JSON={}

# Public address of the API, used in webhook URLs (Slack, Teams, WhatsApp, Stripe). Use a tunnel for local testing.
PUBLIC_API_URL=http://localhost:4000
# Stripe billing (optional). Without STRIPE_SECRET_KEY billing is off and there are no plan limits.
# See docs/08-integrations-setup.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
